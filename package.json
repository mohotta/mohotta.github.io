{
  "name": "portfolio-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:portfolio": "next dev -p 3000",
    "dev:blog": "NEXT_CONFIG_FILE=next.config.blog.js APP_MODE=blog next dev -p 3001",
    "dev:both": "concurrently \"npm run dev:portfolio\" \"npm run dev:blog\"",
    "build": "next build",
    "build:portfolio": "next build && next export",
    "build:blog": "NEXT_CONFIG_FILE=next.config.blog.js APP_MODE=blog next build",
    "start": "next start",
    "start:portfolio": "next start -p 3000",
    "start:blog": "NEXT_CONFIG_FILE=next.config.blog.js APP_MODE=blog next start -p 3001",
    "start:both": "concurrently \"npm run start:portfolio\" \"npm run start:blog\"",
    "lint": "next lint"
  },
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@types/react-transition-group": "^4.4.10",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.1.8",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.419.0",
    "next": "14.2.5",
    "next-themes": "^0.3.0",
    "openai": "^5.16.0",
    "react": "^18",
    "react-awesome-reveal": "^4.2.14",
    "react-dom": "^18",
    "react-icons": "^5.2.1",
    "react-markdown": "^10.1.0",
    "react-transition-group": "^4.4.5",
    "react-type-animation": "^3.2.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.3",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^8.2.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
